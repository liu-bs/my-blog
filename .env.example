# 复制为 .env.local（本地开发）或在部署平台后台配置生产值。不要把真实值提交进仓库。

# PostgreSQL 连接串（Neon，必须）。本地开发用 Neon 的 pooled 连接串。
DATABASE_URL=

# JWT 签名密钥（生产必须，且至少 32 字符；本地不填会自动生成随机密钥）
JWT_SECRET=

# JWT 过期时间（可选，默认 7d）
JWT_EXPIRES_IN=7d

# Token 过期后可换发新 token 的宽限期秒数（可选，默认 3600）
JWT_REFRESH_GRACE_SECONDS=3600

# bcrypt 轮数（可选，默认 10）
BCRYPT_SALT_ROUNDS=10

# 站点对外 URL（可选，用于 sitemap/OG 等绝对链接，默认 http://localhost:3000）
NEXT_PUBLIC_BASE_URL=
